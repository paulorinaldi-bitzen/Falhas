generator playerDbClient {
  provider        = "prisma-client-js"
  output          = "../src/generated/player-db"
  previewFeatures = []
}

datasource db {
  provider = "postgresql"
  url      = env("PLAYER_DATABASE_URL")
}

model Subscription {
  Id                  String               @id(map: "PK_Subscriptions") @db.Uuid
  PlanType            Int
  Status              Int
  StatusObservations  String
  Courtesy            Boolean
  GatewayId           String
  Observations        String
  Excluded            Boolean
  CreatedAt           DateTime             @db.Timestamptz(6)
  UpdatedAt           DateTime             @db.Timestamptz(6)
  WillRenew           Boolean              @default(false)
  SubscriptionDetails SubscriptionDetail[]
  Users               Users[]

  @@map("Subscriptions")
}

model SubscriptionDetail {
  Id                   Int          @id(map: "PK_SubscriptionDetails") @default(autoincrement())
  StartDate            DateTime     @db.Timestamptz(6)
  EndDate              DateTime?    @db.Timestamptz(6)
  Value                Decimal      @db.Decimal
  PaymentStatus        Int
  SubscriptionId       String       @default(dbgenerated("'00000000-0000-0000-0000-000000000000'::uuid")) @db.Uuid
  Excluded             Boolean
  CreatedAt            DateTime     @db.Timestamptz(6)
  UpdatedAt            DateTime     @db.Timestamptz(6)
  GatewayTransactionId String       @default("")
  Store                Int          @default(0)
  StoreProductId       String       @default("")
  Subscriptions        Subscription @relation(fields: [SubscriptionId], references: [Id], onDelete: Cascade, onUpdate: NoAction, map: "FK_SubscriptionDetails_Subscriptions_SubscriptionId")

  @@index([SubscriptionId], map: "IX_SubscriptionDetails_SubscriptionId")
  @@map("SubscriptionDetails")
}

model AdminUsers {
  Id         String   @id(map: "PK_AdminUsers") @db.Uuid
  UserId     String   @db.Uuid
  Permission Int
  Status     Boolean
  Excluded   Boolean
  CreatedAt  DateTime @db.Timestamptz(6)
  UpdatedAt  DateTime @db.Timestamptz(6)
  Users      Users    @relation(fields: [UserId], references: [Id], onDelete: Cascade, onUpdate: NoAction, map: "FK_AdminUsers_Users_UserId")

  @@index([UserId], map: "IX_AdminUsers_UserId")
}

model Episodes {
  Id                 String             @id(map: "PK_Episodes") @db.Uuid
  Name               String             @db.VarChar(60)
  ExpirationDate     DateTime?          @db.Timestamptz(6)
  Description        String
  Transcription      String
  Excluded           Boolean
  CreatedAt          DateTime           @db.Timestamptz(6)
  UpdatedAt          DateTime           @db.Timestamptz(6)
  EpisodeExclusivity Int                @default(0)
  SegmentId          String?            @default(dbgenerated("'00000000-0000-0000-0000-000000000000'::uuid")) @db.Uuid
  Image              String             @default("")
  DurationSeconds    Int                @default(0)
  SegmentBlocked     Boolean            @default(false)
  ReleaseDate        DateTime           @default(dbgenerated("'-infinity'::timestamp with time zone")) @db.Timestamptz(6)
  PackageBlocked     Boolean            @default(false)
  PackageId          String?            @db.Uuid
  PackageOrder       Int                @default(0)
  SpotifyId          String?            @default("") @db.VarChar(255)
  EpisodeStatus      Int                @default(0)
  RemuxAttempts      Int                @default(0)
  Packages           Packages?          @relation(fields: [PackageId], references: [Id], onDelete: NoAction, onUpdate: NoAction, map: "FK_Episodes_Packages_PackageId")
  Segments           Segments?          @relation(fields: [SegmentId], references: [Id], onDelete: NoAction, onUpdate: NoAction, map: "FK_Episodes_Segments_SegmentId")
  FavoriteEpisodes   FavoriteEpisodes[]

  @@index([PackageId], map: "IX_Episodes_PackageId")
  @@index([ReleaseDate], map: "IX_Episodes_ReleaseDate")
  @@index([SegmentId], map: "IX_Episodes_SegmentId")
}

model FavoriteEpisodes {
  Id        Int      @id(map: "PK_FavoriteEpisodes") @default(autoincrement())
  EpisodeId String   @db.Uuid
  UserId    String   @db.Uuid
  Excluded  Boolean
  CreatedAt DateTime @db.Timestamptz(6)
  UpdatedAt DateTime @db.Timestamptz(6)
  Episodes  Episodes @relation(fields: [EpisodeId], references: [Id], onDelete: Cascade, onUpdate: NoAction, map: "FK_FavoriteEpisodes_Episodes_EpisodeId")
  Users     Users    @relation(fields: [UserId], references: [Id], onDelete: Cascade, onUpdate: NoAction, map: "FK_FavoriteEpisodes_Users_UserId")

  @@index([EpisodeId], map: "IX_FavoriteEpisodes_EpisodeId")
  @@index([UserId], map: "IX_FavoriteEpisodes_UserId")
}

model Notices {
  Id                   String    @id(map: "PK_Notices") @db.Uuid
  Title                String    @db.VarChar(60)
  ExpirationDate       DateTime? @db.Timestamptz(6)
  Description          String
  SendPushNotification Boolean
  Excluded             Boolean
  CreatedAt            DateTime  @db.Timestamptz(6)
  UpdatedAt            DateTime  @db.Timestamptz(6)
}

model PackagePrices {
  Id             Int      @id(map: "PK_PackagePrices") @default(autoincrement())
  PackageId      String   @unique(map: "IX_PackagePrices_PackageId") @db.Uuid
  UseStoresPrice Boolean
  UsePonyCoin    Boolean
  PonyCoinPrice  Int
  Packages       Packages @relation(fields: [PackageId], references: [Id], onDelete: Cascade, onUpdate: NoAction, map: "FK_PackagePrices_Packages_PackageId")
}

model Packages {
  Id               String         @id(map: "PK_Packages") @db.Uuid
  Name             String
  AppleProductId   String         @unique(map: "IX_Packages_AppleProductId")
  AndroidProductId String         @unique(map: "IX_Packages_AndroidProductId")
  BeginDate        DateTime       @db.Timestamptz(6)
  EndDate          DateTime?      @db.Timestamptz(6)
  Description      String
  Status           Boolean
  CreatedAt        DateTime       @default(dbgenerated("'-infinity'::timestamp with time zone")) @db.Timestamptz(6)
  Excluded         Boolean        @default(false)
  UpdatedAt        DateTime       @default(dbgenerated("'-infinity'::timestamp with time zone")) @db.Timestamptz(6)
  Image            String         @default("")
  Episodes         Episodes[]
  PackagePrices    PackagePrices?
  UserPackages     UserPackages[]
}

model PollOptions {
  Id                     Int                      @id(map: "PK_PollOptions") @default(autoincrement())
  PollId                 String                   @db.Uuid
  Description            String
  Order                  Int
  Polls                  Polls                    @relation(fields: [PollId], references: [Id], onDelete: Cascade, onUpdate: NoAction, map: "FK_PollOptions_Polls_PollId")
  PollsOptionsUserAnswer PollsOptionsUserAnswer[]

  @@index([PollId], map: "IX_PollOptions_PollId")
}

model Polls {
  Id          String        @id(map: "PK_Polls") @db.Uuid
  Title       String
  Description String
  BeginDate   DateTime      @db.Timestamptz(6)
  EndDate     DateTime      @db.Timestamptz(6)
  IsEmphasis  Boolean
  CreatedAt   DateTime      @default(dbgenerated("'-infinity'::timestamp with time zone")) @db.Timestamptz(6)
  Excluded    Boolean       @default(false)
  UpdatedAt   DateTime      @default(dbgenerated("'-infinity'::timestamp with time zone")) @db.Timestamptz(6)
  PollOptions PollOptions[]
}

model PollsOptionsUserAnswer {
  Id           Int         @id(map: "PK_PollsOptionsUserAnswer") @default(autoincrement())
  PollOptionId Int
  UserId       String      @db.Uuid
  PollOptions  PollOptions @relation(fields: [PollOptionId], references: [Id], onDelete: Cascade, onUpdate: NoAction, map: "FK_PollsOptionsUserAnswer_PollOptions_PollOptionId")

  @@index([PollOptionId], map: "IX_PollsOptionsUserAnswer_PollOptionId")
}

model RefreshTokens {
  Id              String   @id(map: "PK_RefreshTokens") @db.Uuid
  UserId          String   @db.Uuid
  Token           String
  CreatedAt       DateTime @db.Timestamptz(6)
  ExpiresAt       DateTime @db.Timestamptz(6)
  IsUsed          Boolean
  IsRevoked       Boolean
  ReplacedByToken String?
  Users           Users    @relation(fields: [UserId], references: [Id], onDelete: Cascade, onUpdate: NoAction, map: "FK_RefreshTokens_Users_UserId")

  @@index([UserId], map: "IX_RefreshTokens_UserId")
}

model RevenueCatWebhookEvents {
  Id        String   @id(map: "PK_RevenueCatWebhookEvents") @db.Uuid
  EventId   String
  Type      String
  Payload   Json?
  Excluded  Boolean
  CreatedAt DateTime @db.Timestamptz(6)
  UpdatedAt DateTime @db.Timestamptz(6)

  @@index([EventId], map: "IX_RevenueCatWebhookEvents_EventId")
}

model Segments {
  Id                String     @id(map: "PK_Segments") @db.Uuid
  Description       String
  SegmentType       Int
  SubscriptionStart DateTime?  @db.Timestamptz(6)
  SubscriptionEnd   DateTime?  @db.Timestamptz(6)
  Status            Boolean
  Excluded          Boolean
  CreatedAt         DateTime   @db.Timestamptz(6)
  UpdatedAt         DateTime   @db.Timestamptz(6)
  Name              String     @default("") @db.VarChar(60)
  Image             String     @default("")
  Episodes          Episodes[]
}

